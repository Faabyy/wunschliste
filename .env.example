# Kopieren nach .env und ausfüllen. .env kommt nie ins Git.

# Gemeinsamer Zugangscode für alle (einmal pro Gerät). Leer = kein Code (nur im LAN sinnvoll).
WUNSCHLISTE_CODE=

# Passwort für /verwaltung (Konten anlegen). Leer = Web-Verwaltung aus, nur bin/konten.php.
WUNSCHLISTE_ADMIN_PASSWORT=

# 1, wenn die Seite hinter einem Reverse-Proxy mit HTTPS läuft (Cookie bekommt dann „Secure“).
WUNSCHLISTE_HTTPS=0

# 0 schaltet das Auslesen von Preisen aus Links ab.
WUNSCHLISTE_PREISABRUF=1
